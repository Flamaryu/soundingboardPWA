{
  "name": "echogram-sounding-board-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:pwa",
    "dev:pwa": "npm run dev -w @echogram/pwa",
    "dev:admin": "npm run dev -w @echogram/admin",
    "build:pwa": "npm run build -w @echogram/pwa",
    "build:admin": "npm run build -w @echogram/admin",
    "build:shared": "npm run build -w @echogram/shared-db",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  }
}
